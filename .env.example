# Copy to .env and fill in. .env stays out of git, it holds the keys.

###############################################################################
# Web server (Caddy / FrankenPHP)
###############################################################################
# The names the gateway answers to, separated by commas; Caddy gets their certificates itself.
SERVER_NAME=netair.tv, www.netair.tv

# Behind a proxy that routes TLS by SNI and sends the PROXY protocol (e.g. HAProxy send-proxy-v2):
# LISTENER_MODE=behind-proxy and the proxy's network, where the PROXY header is trusted from.
# The gateway recognises customers by their address, so without the PROXY header from the proxy
# every customer would look like the proxy. Without a proxy only this machine is trusted.
#LISTENER_MODE=direct
#PROXY_ALLOW=192.168.1.0/24 fd0e:b807:26ee:1::/64

###############################################################################
# Watcher CRM, which says who is connected at an address
###############################################################################
# The customer portal API of the CRM
CRM_API_URL=https://crm.example.net/api/customer-portal
# API key of a CRM user of its own with the customer-portal role
CRM_API_KEY=
# Only against a development CRM with a certificate of its own
#CRM_API_VERIFY_TLS=false

###############################################################################
# TV provider
###############################################################################
# Which provider customers are signed in to: sledovanitv
TV_PROVIDER=sledovanitv

# SledovaniTV partner API (https://redoc.moderntv.app/?url=https://sledovanitv.cz/partner/api/_/apidoc)
SLEDOVANITV_PARTNER=
SLEDOVANITV_PASSWORD=
#SLEDOVANITV_API_URL=https://sledovanitv.cz/partner/api

###############################################################################
# Operator
###############################################################################
# Shown on the pages a customer sees when they cannot be signed in
OPERATOR_NAME=NETAIR, s.r.o.
SUPPORT_PHONE=+420 604 553 444

# Customers of these companies are not offered the service: parts of the company name,
# separated by commas, in any letter case
#EXCLUDED_COMPANIES=

# Pages and playlist entries of your own (other texts or language): a directory with the same
# files as templates/, mounted into the container
#TEMPLATES_DIR=/app/custom-templates
